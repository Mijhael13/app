<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".MainActivity">

    <!-- Background Decoration (Top Right) -->

    <!-- Background Decoration (Bottom Left) -->
    <View
        android:id="@+id/bg_top_right"
        android:layout_width="350dp"
        android:layout_height="350dp"
        android:layout_marginTop="-150dp"
        android:layout_marginEnd="-120dp"
        android:background="@drawable/bg_purple_circle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/bg_bottom_left"
        android:layout_width="350dp"
        android:layout_height="350dp"
        android:layout_marginStart="-120dp"
        android:layout_marginBottom="-150dp"
        android:background="@drawable/bg_purple_circle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Muscle Arm Silhouette (4th image) -->

    <!-- Logo "MYOS" (1st image) -->
    <ImageView
        android:id="@+id/img_muscle_arm"
        android:layout_width="282dp"
        android:layout_height="203dp"
        android:layout_marginTop="16dp"
        android:adjustViewBounds="true"
        android:contentDescription="Muscle Silhouette"
        android:src="@drawable/img_muscle_silhouette"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Bunny Character (2nd image) -->
    <ImageView
        android:id="@+id/img_logo"
        android:layout_width="201dp"
        android:layout_height="77dp"
        android:layout_marginTop="-40dp"
        android:adjustViewBounds="true"
        android:contentDescription="MYOS Logo"
        android:src="@drawable/img_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/img_muscle_arm" />

    <ImageView
        android:id="@+id/img_character"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="361dp"
        android:adjustViewBounds="true"
        android:contentDescription="Bunny Character"
        android:src="@drawable/img_character"
        app:layout_constraintBottom_toBottomOf="@+id/bg_bottom_left"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/img_logo" />

    <!-- Play Button (3rd image) -->
    <ImageView
        android:id="@+id/btn_play"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="92dp"
        android:adjustViewBounds="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="Boton Jugar"
        android:focusable="true"
        android:src="@drawable/img_play_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.473"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bg_bottom_left" />

</androidx.constraintlayout.widget.ConstraintLayout>