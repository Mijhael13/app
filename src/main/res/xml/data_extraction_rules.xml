<?xml version="1.0" encoding="utf-8"?>
<!--
   Configuración de reglas de extracción de datos para copias de seguridad.
   Esto asegura que el progreso del usuario (como niveles completados) se guarde en la nube.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Incluimos todas las preferencias compartidas y bases de datos por defecto -->
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
    </device-transfer>
</data-extraction-rules>